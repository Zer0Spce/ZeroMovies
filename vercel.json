{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node web/scripts/build.cjs",
  "outputDirectory": "web/public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key":"X-Content-Type-Options","value":"nosniff"},
        {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
        {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"},
        {"key":"Content-Security-Policy","value":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' https://image.tmdb.org data:; connect-src 'self'; frame-src https://vidstuck.xyz; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"}
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {"key":"Cache-Control","value":"public, max-age=86400"}
      ]
    }
  ]
}
