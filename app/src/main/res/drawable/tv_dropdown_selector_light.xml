<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle"><solid android:color="#3354E5C1"/><stroke android:width="3dp" android:color="#FF0A715E"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#2A54E5C1"/><stroke android:width="3dp" android:color="#FF0A715E"/><corners android:radius="10dp"/></shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle"><solid android:color="#1F54E5C1"/><stroke android:width="2dp" android:color="#CC0A715E"/><corners android:radius="10dp"/></shape>
    </item>
    <item><shape android:shape="rectangle"><solid android:color="#FFFFFFFF"/><stroke android:width="1dp" android:color="#FFD1D9E4"/><corners android:radius="10dp"/></shape></item>
</selector>
